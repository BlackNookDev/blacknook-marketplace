# Docker Compose / Coolify ortam değişkenleri
# Kullanım: cp .env.docker.example .env && docker compose up -d --build

# PostgreSQL (postgres servisi ile paylaşılır)
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=blacknook

# Next.js uygulaması
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Lokal portlar (Coolify'de proxy kullanılır, port map gerekmez)
APP_PORT=3000
PGADMIN_PORT=5050

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@blacknook.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# OAuth (opsiyonel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spline (opsiyonel)
NEXT_PUBLIC_SPLINE_URL=

# E-posta — kurulum talebi, match, waitlist bildirimleri (opsiyonel)
INSTALLATION_REQUEST_TO=dev@blacknook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BlackNOOK <noreply@blacknook.com>
