# Docker Compose — bu makinede build, Nginx Proxy Manager ile domain bağla
# Kullanım: cp .env.docker.example .env && docker compose up -d --build

# PostgreSQL — sadece Docker ağı içinde (host portu yok)
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=blacknook

# Domain (Nginx Proxy Manager)
# app     → blacknook.com     (upstream: 127.0.0.1:18080) — FE + /api aynı domain
# pgadmin → db.blacknook.com  (upstream: 127.0.0.1:18081)
NEXT_PUBLIC_APP_URL=https://blacknook.com
NEXTAUTH_URL=https://blacknook.com

# Lokal portlar — sadece 127.0.0.1 (NPM nginx buraya yönlendirir)
APP_PORT=18080
PGADMIN_PORT=18081

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@blacknook.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# OAuth (opsiyonel) — callback: https://blacknook.com/api/auth/callback/...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH=

# Spline (opsiyonel)
NEXT_PUBLIC_SPLINE_URL=

# E-posta — kurulum talebi, match, waitlist bildirimleri (opsiyonel)
INSTALLATION_REQUEST_TO=dev@blacknook.com
# Eşleşme talepleri
MATCH_REQUEST_TO=contact@blacknook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BlackNOOK <noreply@blacknook.com>
