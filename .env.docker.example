# Docker Compose / Coolify ortam değişkenleri
# Kullanım: cp .env.docker.example .env && docker compose up -d --build

# PostgreSQL — sadece Docker ağı içinde (host portu yok)
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=blacknook

# Domainler (Coolify reverse proxy ile eşleştir)
# app servisi → blacknook.com + api.blacknook.com (aynı container, port 3000)
# pgadmin servisi → db.blacknook.com (port 80)
NEXT_PUBLIC_APP_URL=https://blacknook.com
NEXT_PUBLIC_API_URL=https://api.blacknook.com
NEXTAUTH_URL=https://blacknook.com
AUTH_COOKIE_DOMAIN=.blacknook.com

# Lokal erişim portları (sık kullanılmayan — 3000/5432 ile çakışmaz)
APP_PORT=18080
PGADMIN_PORT=18081

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@blacknook.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# OAuth (opsiyonel) — callback: https://blacknook.com/api/auth/callback/...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spline (opsiyonel)
NEXT_PUBLIC_SPLINE_URL=

# E-posta — kurulum talebi, match, waitlist bildirimleri (opsiyonel)
INSTALLATION_REQUEST_TO=dev@blacknook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BlackNOOK <noreply@blacknook.com>
