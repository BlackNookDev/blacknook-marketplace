# Docker Compose — yalnızca Next.js. PostgreSQL ayrı (Coolify DB veya harici).
# Kullanım: cp .env.docker.example .env && docker compose up -d --build

# Coolify Postgres → General → Postgres URL (internal) içindeki host
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=false

# Domain
# app → blacknook.com (upstream: 127.0.0.1:18080) — FE + /api aynı domain
NEXT_PUBLIC_APP_URL=https://blacknook.com
NEXTAUTH_URL=https://blacknook.com
NEXTAUTH_SECRET=

# Lokal port — sadece 127.0.0.1
APP_PORT=18080

# Partner görselleri — compose volume /app/uploads
UPLOAD_DIR=/app/uploads

# Uygulama admin (ilk kurulumda yoksa oluşturulur)
ADMIN_EMAIL=admin@blacknook.com
ADMIN_PASSWORD=BlacknookAdmin1
ADMIN_NAME=Admin

# OAuth (opsiyonel) — callback: https://blacknook.com/api/auth/callback/...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH=

# Spline (opsiyonel)
NEXT_PUBLIC_SPLINE_URL=

# E-posta — Gmail App Password (kayıt, waitlist, kurulum, eşleşme, şifre sıfırlama)
# Google → Güvenlik → 2FA → Uygulama şifreleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=Blacknook <your@gmail.com>
INSTALLATION_REQUEST_TO=dev@blacknook.com
MATCH_REQUEST_TO=contact@blacknook.com
