# PostgreSQL — TablePlus ile birebir aynı alanlar (URL kullanılmaz)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=blacknook
DB_SSL=false
# Mac Postgres.app: şifre yokken Next.js otomatik /tmp soketini kullanır (DB_SOCKET=/tmp ile zorlanabilir)
# Vercel: managed Postgres host + DB_SSL=true

# Site URL (SEO canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://blacknook.com
NEXT_PUBLIC_APP_URL=https://blacknook.com

# NextAuth — Vercel'de ZORUNLU (Settings → Environment Variables)
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Production site URL (Vercel'de kendi domain'iniz)
NEXTAUTH_URL=https://your-app.vercel.app

# OAuth (opsiyonel — kayıt/girişte Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Spline (opsiyonel, public URL)
NEXT_PUBLIC_SPLINE_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode

# Kurulum talebi e-postası (SMTP)
INSTALLATION_REQUEST_TO=dev@blacknook.com
# Eşleşme talepleri (varsayılan: contact@blacknook.com)
MATCH_REQUEST_TO=contact@blacknook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BlackNOOK <noreply@blacknook.com>"
